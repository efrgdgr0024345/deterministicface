{
  "name": "DeterministicFace working demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {"ghcr.io/devcontainers/features/github-cli:1": {}},
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "DeterministicFace demo", "onAutoForward": "openBrowser", "protocol": "http"}},
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "postCreateCommand": "npm ci --ignore-scripts --no-audit --no-fund && npm test",
  "postStartCommand": "node scripts/manage-demo.mjs start",
  "waitFor": "postCreateCommand",
  "customizations": {"codespaces": {"openFiles": ["README.md"]}}
}
